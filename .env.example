# Use the Trust's public HTTPS domain before deployment.
SITE_URL=http://localhost:3000

# Public Sanity identifiers. The site works from bundled content until connected.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_WEBHOOK_SECRET=
# Only needed for the one-time CMS import; never expose in NEXT_PUBLIC variables.
SANITY_WRITE_TOKEN=

# Trust-owned mailbox. Port 465 uses implicit TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ENQUIRY_TO=auragolden4@gmail.com

# Optional existing cookieless Plausible account; leave empty when not connected.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
